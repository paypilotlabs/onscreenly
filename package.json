{
  "name": "onscreenly",
  "version": "0.2.4",
  "description": "Onscreenly: an open-source AI overlay for screen context, microphone transcription, and meeting assistance.",
  "license": "GPL-3.0-or-later",
  "author": "Lohith Kumar <lkneerukonda@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs}\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare:whisper": "node scripts/prepare-whisper-runtime.js",
    "verify:whisper-runtime": "node scripts/verify-whisper-runtime.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac zip --x64 --arm64",
    "dist:mac": "electron-builder --mac zip --x64 --arm64",
    "dist:mac:x64": "electron-builder --mac zip --x64",
    "dist:mac:arm64": "electron-builder --mac zip --arm64",
    "dist:win": "electron-builder --win",
    "pack:win": "electron-builder --win --dir",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage --arm64"
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "windows",
    "cross-platform"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "extract-zip": "^2.0.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "resedit": "^3.0.2",
    "tar": "^7.5.22",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^2.12.0",
    "lucide-static": "^0.468.0",
    "mammoth": "^1.8.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  },
  "contributors": [
    "Onscreenly contributors",
    "Cue contributors (upstream, https://github.com/Blueturboguy07/cue)"
  ]
}
